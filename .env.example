# Runtime
NODE_ENV=development
PORT=8080
# Vite serves the browser on 5174 and proxies same-origin API calls to PORT 8080.
PUBLIC_BASE_URL=http://localhost:5174
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mestizo_umami
DATABASE_MAX_CONNECTIONS=10
TRUST_PROXY=false
LOG_LEVEL=info

# OpenID Connect authorization-code flow with PKCE.
# Register PUBLIC_BASE_URL/api/auth/callback as the exact provider callback URI.
OIDC_ISSUER=https://your-trusted-provider.example/
OIDC_CLIENT_ID=
# Leave blank only when the provider registered this as a public PKCE client.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email offline_access

# Generate independent secrets. TOKEN_ENCRYPTION_KEY must decode to exactly 32 bytes.
# Example commands: openssl rand -base64 32  |  openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=
CSRF_SECRET=
SESSION_TTL_SECONDS=2592000
OIDC_ATTEMPT_TTL_SECONDS=600
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Internal seven-day trial followed by immediate Stripe subscription checkout.
TRIAL_DAYS=7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SUBSCRIPTION_PRICE_DISPLAY='$4.99/month'

# Instacart Developer Platform. Use connect.dev.instacart.tools with a development key.
INSTACART_API_KEY=
INSTACART_API_BASE_URL=https://connect.dev.instacart.tools

# Public build-time affiliate identifiers. These appear in outbound browser links.
VITE_AMAZON_ASSOCIATE_TAG=
# The exact approved Walmart/affiliate redirect template must contain the literal token {url}.
VITE_WALMART_AFFILIATE_LINK_TEMPLATE=
